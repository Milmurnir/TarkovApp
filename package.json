{
  "name": "tarkov-quest-tracker",
  "private": true,
  "version": "0.9.3",
  "shellVersion": 4,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron": "npm run build && electron .",
    "release:ui": "npm run build && node scripts/package-ui.mjs",
    "dist": "npm run build && electron-packager . TarkovQuestRouter --platform=win32 --arch=x64 --out=release --overwrite --asar --ignore=\"^/src$\" --ignore=\"^/src/\" --ignore=\"^/scripts\" --ignore=\"^/public\" --ignore=\"^/release\" --ignore=\"^/node_modules\" --ignore=\"^/\\.claude\" --ignore=\"^/tsconfig\" --ignore=\"^/vite\\.config\" --ignore=\"\\.md$\"",
    "release:app": "npm run dist && node scripts/package-app.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^41.7.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "main": "electron/main.cjs",
  "description": "Quest routing for Escape from Tarkov"
}